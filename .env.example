# Copia questo file in .env e compila i valori. Il file .env non entra mai in git.

# Sanity: progetto e dataset (servono a script, Studio e sito)
SANITY_PROJECT_ID=
SANITY_DATASET=
# Token con permesso di scrittura: SOLO per lo script di import. Da revocare dopo il precaricamento.
SANITY_WRITE_TOKEN=

# Cartelle delle foto (facoltative: se vuote si usano src/photos/original e src/photos/backup)
FOTO_ORIGINALI=
FOTO_LAVORO=
