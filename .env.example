# Copia questo file in .env e compila i valori. Il file .env non entra mai in git.

# Sanity: progetto e dataset (servono a script, Studio e sito)
SANITY_PROJECT_ID=
SANITY_DATASET=
# Token con permesso di scrittura: SOLO per lo script di import. Da revocare dopo il precaricamento.
SANITY_WRITE_TOKEN=

# Cartelle delle foto (facoltative: se vuote si usano src/photos/original e src/photos/backup)
FOTO_ORIGINALI=
FOTO_LAVORO=

# Modulo contatti (in locale vanno in web/.dev.vars, al deploy con "wrangler secret put")
# Segreto Turnstile: in locale la chiave di prova ufficiale 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
CONTATTI_DESTINATARIO=
CONTATTI_MITTENTE=
# Chiave pubblica Turnstile (al build). Vuota = chiave di prova ufficiale.
PUBLIC_TURNSTILE_SITE_KEY=
# Dominio del sito per sitemap e link canonici (vuoto = https://ireneneri.photography)
SITO_URL=
# Cloudflare Web Analytics (statistiche senza cookie): token del sito, al build. Vuoto = nessuno script.
PUBLIC_CF_WEB_ANALYTICS_TOKEN=
