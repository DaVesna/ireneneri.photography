{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "src/**/*", "astro.config.mjs"],
  "exclude": ["dist"],
  "compilerOptions": {
    "allowJs": true,
    "exactOptionalPropertyTypes": false,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "types": ["@cloudflare/workers-types"]
  }
}
