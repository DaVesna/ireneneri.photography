---
import Base from '../../layouts/Base.astro'
import Immagine from '../../components/Immagine.astro'
import { leggiAlbum, leggiCategorieUsate } from '../../lib/sanity.ts'
import { anno, dataELuogo } from '../../lib/testi.ts'
import { LARGHEZZE_RIDOTTE, orizzontale } from '../../lib/immagini.ts'
import '../../styles/elenco.css'

const [album, categorie] = await Promise.all([leggiAlbum(), leggiCategorieUsate()])
const anni = [...new Set(album.map((a) => anno(a.data)))].sort((a, b) => b.localeCompare(a))
// Forma della tessera nel mosaico: la più recente grande, poi verticali alte e orizzontali larghe.
const forma = (i: number, verticale: boolean) => (i === 0 ? 'grande' : verticale ? 'alta' : 'larga')
---

<Base titolo="Album" descrizione={`Tutti gli album di Irene Neri: ${album.length} servizi, dal più recente.`}>
  <div class="pagina elenco">
    <header class="elenco-testa">
      <h1 class="titolo">Album</h1>
      {
        (categorie.length > 1 || anni.length > 1) && (
          <form class="filtri" hidden data-filtri aria-label="Filtra gli album">
            {categorie.length > 1 && (
              <fieldset>
                <legend class="solo-lettori">Categoria</legend>
                <label>
                  <input type="radio" name="categoria" value="" checked />
                  <span class="etichetta">Tutti</span>
                </label>
                {categorie.map((c) => (
                  <label>
                    <input type="radio" name="categoria" value={c.slug} />
                    <span class="etichetta">{c.titolo}</span>
                  </label>
                ))}
              </fieldset>
            )}
            {anni.length > 1 && (
              <fieldset>
                <legend class="solo-lettori">Anno</legend>
                <label>
                  <input type="radio" name="anno" value="" checked />
                  <span class="etichetta">Ogni anno</span>
                </label>
                {anni.map((y) => (
                  <label>
                    <input type="radio" name="anno" value={y} />
                    <span class="etichetta">{y}</span>
                  </label>
                ))}
              </fieldset>
            )}
          </form>
        )
      }
    </header>

    <p class="esito" aria-live="polite" data-esito></p>

    <ul class="mosaico">
      {
        album.map((a, i) => (
          <li class:list={['tessera', 'entra', forma(i, !orizzontale(a.copertina))]} data-categoria={a.categoria?.slug ?? ''} data-anno={anno(a.data)}>
            <a href={`/album/${a.slug}/`}>
              <Immagine
                img={a.copertina}
                alt=""
                sizes={i === 0 ? '(max-width: 760px) 100vw, 50vw' : '(max-width: 760px) 50vw, 25vw'}
                scala={LARGHEZZE_RIDOTTE}
                larghezzaMassima={i === 0 ? 2000 : 1200}
                vt={`copertina-${a.slug}`}
              />
              <span class="tessera-testo">
                <span class="tessera-titolo">{a.titolo}</span>
                <span class="tessera-dati">{dataELuogo(a.data, a.luogo)}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="vuoto" hidden data-vuoto>
      <p class="introduzione">Nessun album con questa combinazione di categoria e anno.</p>
      <button type="button" class="pulsante" data-azzera>Mostra tutti gli album</button>
    </div>
    <p class="altri-box"><button type="button" class="pulsante" hidden data-altri>Mostra altri album</button></p>
    {album.length === 0 && <p class="introduzione">Gli album arriveranno presto.</p>}
  </div>
</Base>

<script>
  import { avviaFiltro } from '../../scripts/filtro.ts'
  avviaFiltro()
</script>
