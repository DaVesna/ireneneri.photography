---
import Base from '../../layouts/Base.astro'
import Immagine from '../../components/Immagine.astro'
import { leggiAlbum, leggiAlbumCompleto, type AlbumBreve } from '../../lib/sanity.ts'
import { compatta, LARGHEZZE_RIDOTTE, precarica, stileVelatura } from '../../lib/immagini.ts'
import { dataELuogo, paragrafi, testoSemplice } from '../../lib/testi.ts'
import '../../styles/album.css'

export async function getStaticPaths() {
  const tutti = await leggiAlbum()
  return tutti.map((a, i) => ({
    params: { slug: a.slug },
    props: {
      // Ordine per data, dal più recente: "successivo" è il più vecchio, in giro continuo.
      successivo: tutti.length > 1 ? tutti[(i + 1) % tutti.length] : undefined,
      precedente: tutti.length > 2 ? tutti[(i - 1 + tutti.length) % tutti.length] : undefined,
    },
  }))
}

interface Props {
  successivo?: AlbumBreve
  precedente?: AlbumBreve
}
const { successivo, precedente } = Astro.props
const album = await leggiAlbumCompleto(Astro.params.slug!)
if (!album) return Astro.redirect('/404/')

const n = album.foto.length
const altRipiego = (i: number) => `${album.titolo}, foto ${i + 1} di ${n}`
const datiVisore = album.foto.map((f, i) => ({
  ...compatta(f),
  a: f.alt?.trim() || altRipiego(i),
  ...(f.didascalia?.trim() ? { d: f.didascalia.trim() } : {}),
}))
// Album con una sola foto che è anche la copertina: niente galleria, la copertina apre il visore.
const soloCopertina = n === 1 && album.foto[0]?.asset._id === album.copertina.asset._id
const descrizione = testoSemplice(album.testo) || `${album.titolo}: ${n} foto di Irene Neri.`
// Galleria a righe giustificate: ogni foto larga in proporzione alla sua forma, nessun ritaglio.
const sizesGalleria = (r: number) =>
  `(max-width: 760px) ${Math.min(100, Math.round(r * 55))}vw, ${Math.min(100, Math.round(r * 30))}vw`
---

<Base
  titolo={album.titolo}
  descrizione={descrizione}
  immagine={album.copertina}
  tinta={stileVelatura(album.copertina)}
  precarica={[precarica(album.copertina, '100vw')!]}
  suFoto
>
  <article>
    <header class="apertura-album parallasse">
      <Immagine img={album.copertina} alt={album.copertina.alt ?? album.titolo} sizes="100vw" priorita vt={`copertina-${album.slug}`} />
      <div class="apertura-testo">
        <h1 class="titolo">{album.titolo}</h1>
        <p class="dati">{dataELuogo(album.data, album.luogo)}</p>
      </div>
      {
        soloCopertina && (
          <a class="apri-copertina" href="#foto-1" id="foto-1">
            <span class="solo-lettori">Apri la foto a tutto schermo</span>
          </a>
        )
      }
    </header>

    <div class="album-intro">
      {
        album.categoria && (
          <a class="etichetta" href={`/album/?categoria=${album.categoria.slug}`}>
            {album.categoria.titolo}
          </a>
        )
      }
      {album.testo?.length ? <div class="prosa introduzione" set:html={paragrafi(album.testo)} /> : null}
      {n > 1 && <p class="dati">{n} foto. Aprine una per vederla a tutto schermo.</p>}
    </div>

    {
      !soloCopertina && n > 0 && (
        <ul class="galleria" aria-label={`Foto dell’album ${album.titolo}`}>
          {album.foto.map((f, i) => {
            const r = f.asset.larghezza / f.asset.altezza
            return (
              <li class="entra" style={`--r:${r.toFixed(4)}`}>
                <a href={`#foto-${i + 1}`} id={`foto-${i + 1}`} aria-label={`Apri a tutto schermo la foto ${i + 1} di ${n}`}>
                  <Immagine img={f} alt={altRipiego(i)} sizes={sizesGalleria(r)} scala={LARGHEZZE_RIDOTTE} priorita={false} />
                </a>
              </li>
            )
          })}
        </ul>
      )
    }
  </article>

  {
    successivo && (
      <nav class="altri-album" aria-label="Altri album">
        <a class="successivo parallasse" href={`/album/${successivo.slug}/`}>
          <Immagine img={successivo.copertina} alt="" sizes="100vw" larghezzaMassima={2000} />
          <span class="successivo-testo">
            <span class="etichetta">Album successivo</span>
            <span class="titolo-medio">{successivo.titolo}</span>
          </span>
        </a>
        {precedente && precedente.slug !== successivo.slug && (
          <p class="precedente">
            <a href={`/album/${precedente.slug}/`}>Album precedente: {precedente.titolo}</a>
          </p>
        )}
      </nav>
    )
  }

  <dialog class="visore" aria-label={`Foto dell’album ${album.titolo}`}>
    <button class="chiudi" type="button">Chiudi</button>
    <figure>
      <img alt="" sizes="100vw" draggable="false" />
      <figcaption hidden></figcaption>
    </figure>
    <div class="barra">
      <span class="contatore" aria-live="polite"></span>
      <div class="comandi">
        <button type="button" data-v="-1" aria-label="Foto precedente">‹</button>
        <button type="button" data-v="1" aria-label="Foto successiva">›</button>
      </div>
    </div>
  </dialog>
  <script type="application/json" id="dati-visore" set:html={JSON.stringify(datiVisore).replace(/</g, '\\u003c')} />
</Base>

<script>
  import { avviaVisore } from '../../scripts/visore.ts'
  avviaVisore()
</script>
