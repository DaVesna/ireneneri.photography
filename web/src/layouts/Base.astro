---
import '../styles/font.css'
import fontUrl from '@fontsource-variable/work-sans/files/work-sans-latin-wght-normal.woff2?url'
import '../styles/globale.css'
import Testata from '../components/Testata.astro'
import Piede from '../components/Piede.astro'
import { leggiImpostazioni, type Immagine } from '../lib/sanity.ts'
import { urlRitaglio } from '../lib/immagini.ts'

interface Props {
  titolo?: string
  descrizione?: string
  immagine?: Immagine
  /** Variabili CSS della tinta, applicate a tutta la pagina. */
  tinta?: string
  noindex?: boolean
  /** Carica lo script di Cloudflare Turnstile (solo pagine con il modulo contatti). */
  turnstile?: boolean
  /** Foto principale della pagina, da precaricare (la più grande della prima schermata). */
  precarica?: { srcset: string; sizes: string; src: string; media?: string }[]
  /** La pagina si apre con una foto a tutta larghezza: la testata ci sta sopra, in bianco. */
  suFoto?: boolean
  /** Mostra la firma nella testata (in home no: la firma grande è già nell'apertura). */
  conMarchio?: boolean
}
const { titolo, descrizione, immagine, tinta, noindex = false, turnstile = false, precarica = [], suFoto = false, conMarchio = true } = Astro.props
const impostazioni = await leggiImpostazioni()
const nomeSito = impostazioni?.nomeSito || 'Irene Neri, fotografa'
const titoloPagina = titolo ? `${titolo} — ${nomeSito}` : nomeSito
const desc = (descrizione || impostazioni?.descrizione || '').slice(0, 200)
const condivisione = immagine ?? impostazioni?.immagineCondivisione
const ogImg = condivisione ? urlRitaglio(condivisione, 1200, 630) : undefined
const canonico = new URL(Astro.url.pathname, Astro.site).href
// Cloudflare Web Analytics: lo script si carica solo se al build è impostato il token del sito.
const tokenStatistiche: string = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN || ''
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloPagina}</title>
    {desc && <meta name="description" content={desc} />}
    <link rel="canonical" href={canonico} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f3f2ee" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    {precarica.map((p) => <link rel="preload" as="image" href={p.src} imagesrcset={p.srcset} imagesizes={p.sizes} media={p.media} fetchpriority="high" />)}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={nomeSito} />
    <meta property="og:title" content={titolo ?? nomeSito} />
    {desc && <meta property="og:description" content={desc} />}
    <meta property="og:url" content={canonico} />
    {ogImg && <meta property="og:image" content={ogImg} />}
    {ogImg && <meta property="og:image:width" content="1200" />}
    {ogImg && <meta property="og:image:height" content="630" />}
    {condivisione?.alt && <meta property="og:image:alt" content={condivisione.alt} />}
    <meta name="twitter:card" content="summary_large_image" />
    {turnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  </head>
  <body style={tinta}>
    <a class="salta" href="#contenuto">Vai al contenuto</a>
    <Testata suFoto={suFoto} conMarchio={conMarchio} />
    <main id="contenuto" tabindex="-1">
      <slot />
    </main>
    <Piede />
    <script>
      import '../scripts/protezione.ts'
    </script>
    {
      tokenStatistiche && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: tokenStatistiche })}
        />
      )
    }
  </body>
</html>
