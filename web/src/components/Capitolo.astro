---
// Un album in evidenza nella home: fascia larga con la copertina in parallasse, titolo e pulsante;
// sotto, tre foto dell'album che entrano mentre si scorre.
import Immagine from './Immagine.astro'
import type { AlbumBreve } from '../lib/sanity.ts'
import { LARGHEZZE_RIDOTTE } from '../lib/immagini.ts'
import { dataELuogo, quanteFoto } from '../lib/testi.ts'

interface Props {
  album: AlbumBreve
}
const { album } = Astro.props
const href = `/album/${album.slug}/`
const anteprime = album.anteprime ?? []
---

<section class="capitolo" aria-labelledby={`cap-${album.slug}`}>
  <a class="fascia parallasse" href={href}>
    <Immagine img={album.copertina} alt="" sizes="100vw" vt={`copertina-${album.slug}`} />
    <span class="fascia-testo">
      <span class="titolo-medio" id={`cap-${album.slug}`}>{album.titolo}</span>
      <span class="dati">{dataELuogo(album.data, album.luogo)}</span>
      <span class="pulsante chiaro">Guarda l’album</span>
    </span>
  </a>
  {
    anteprime.length > 0 && (
      <ul class="fila">
        {anteprime.map((f) => (
          <li class="entra">
            <a href={href} tabindex="-1" aria-hidden="true">
              <Immagine img={f} alt="" sizes="(max-width: 760px) 70vw, 31vw" scala={LARGHEZZE_RIDOTTE} larghezzaMassima={1600} />
            </a>
          </li>
        ))}
        <li class="fila-link entra">
          <a href={href}>
            {quanteFoto(album.numeroFoto)}
            <span class="solo-lettori"> nell’album {album.titolo}</span>
          </a>
        </li>
      </ul>
    )
  }
</section>
