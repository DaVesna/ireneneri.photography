---
// Foto da Sanity: srcset, sizes, dimensioni esplicite, caricamento differito e segnaposto sfocato (LQIP).
// Proporzione naturale: nessun ritaglio. Dove serve un'inquadratura (CSS object-fit), il punto
// focale scelto da Irene arriva come --fx/--fy.
import type { Immagine } from '../lib/sanity.ts'
import { sorgente } from '../lib/immagini.ts'

interface Props {
  img: Immagine
  sizes: string
  alt?: string
  class?: string
  priorita?: boolean
  vt?: string
  id?: string
  larghezzaMassima?: number
  scala?: readonly number[]
  /** Diapositiva non ancora visibile: il file vero si carica da script poco prima di mostrarla. */
  differita?: boolean
  loading?: 'lazy' | 'eager'
}
const { img, sizes, alt, class: classe, priorita = false, vt, id, larghezzaMassima, scala, differita = false, loading } = Astro.props
const s = sorgente(img, larghezzaMassima, scala)
const testoAlt = (img.alt ?? alt ?? '').trim()
const stile = [
  `--r:${(s.width / s.height).toFixed(4)}`,
  `--fx:${s.fx}`,
  `--fy:${s.fy}`,
  s.lqip ? `background-image:url(${s.lqip})` : '',
  vt ? `view-transition-name:${vt}` : '',
]
  .filter(Boolean)
  .join(';')
---

<img
  src={differita ? s.lqip : s.src}
  srcset={differita ? undefined : s.srcset}
  data-src={differita ? s.src : undefined}
  data-srcset={differita ? s.srcset : undefined}
  sizes={sizes}
  width={s.width}
  height={s.height}
  alt={testoAlt}
  loading={loading ?? (priorita ? 'eager' : 'lazy')}
  fetchpriority={priorita ? 'high' : 'auto'}
  decoding={priorita ? 'sync' : 'async'}
  draggable="false"
  class:list={['foto', classe]}
  style={stile}
  id={id}
/>
