---
import { leggiContatti, leggiImpostazioni } from '../lib/sanity.ts'
import { daFornire } from '../lib/testi.ts'

const [impostazioni, contatti] = await Promise.all([leggiImpostazioni(), leggiContatti()])
const testo = impostazioni?.testoPiede || 'Irene Neri, fotografa'
const instagram = contatti?.instagram && !daFornire(contatti.instagram) ? contatti.instagram : null
const email = contatti?.emailPubblica && !daFornire(contatti.emailPubblica) ? contatti.emailPubblica : null
---

<footer class="piede">
  <span>{testo}</span>
  <ul>
    {
      instagram && (
        <li>
          <a href={instagram} rel="noopener">
            Instagram
          </a>
        </li>
      )
    }
    {
      email && (
        <li>
          <a href={`mailto:${email}`}>Email</a>
        </li>
      )
    }
    <li><a href="/privacy/">Privacy</a></li>
  </ul>
</footer>
